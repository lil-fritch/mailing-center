# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT_ID_MAIL_GENERATOR=your_mail_generator_assistant_id
OPENAI_ASSISTANT_ID_ANSWER_GENERATOR=your_answer_generator_assistant_id

# Mail API Settings
MAIL_API_URL=http://127.0.0.1:8001/email/send
MAIL_API_URL_2=http://127.0.0.1:8002/email/send
MAIL_API_BASE_URL=http://127.0.0.1:8001
MAIL_API_KEY=your_mail_api_key_here

# Email Campaign Settings
EMAIL_PAUSE_SECONDS=1.0
EMAIL_PAUSE_MIN_SECONDS=0.5
EMAIL_PAUSE_MAX_SECONDS=2.0
CAMPAIGN_FROM_EMAILS=email1@example.com,email2@example.com

# Campaign Work Hours (local time in campaign timezone, 24-hour format)
CAMPAIGN_WORK_START_HOUR=9
CAMPAIGN_WORK_END_HOUR=18

# Sender Accounts Files
SENDER_ACCOUNTS_FILE=app/config/sender_accounts.json
SENDER_ACCOUNTS_FILE_2=app/config/sender_accounts_2.json

# Parallel AI Settings
PARALLEL_KEY=your_parallel_key_here

# Database Settings
DATABASE_URL=postgresql://username:password@localhost:5432/mailing_center
DATABASE_ECHO=false

# Dashboard auth
SITE_PASSWORD=change-me
JWT_SECRET_KEY=change-me-too
JWT_EXPIRE_MINUTES=720
